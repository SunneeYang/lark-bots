# 飞书机器人服务配置文件示例
# 复制此文件为 bots.yaml 并填入你的实际配置

# 机器人群 ID（所有机器人必须加入此群）
# 获取方式: 在飞书群设置中查看群 ID
robot_group_id: "oc_xxxxxxxxxxxxxxxxx"

# 机器人配置列表
bots:
  # ====================
  # 分发机器人 (Dispatcher)
  # ====================
  # 作用:
  #   - 加入用户群，接收用户指令
  #   - 在机器人群分发任务给执行机器人（纯文本，不使用 @mention）
  #   - 收集执行结果并回复用户
  #   - 配置用户白名单进行安全控制
  #   - 支持两种匹配模式：
  #     * 旧模式：精确匹配任务名（task_scripts）
  #     * 新模式：三层语义匹配（tasks + routing_keywords）
  - name: "task-dispatcher"
    app_id: "cli_xxxxxxxxxxxxxxxxx"
    app_secret: "xxxxxxxxxxxxxxxxxxxx"
    role: "dispatcher"
    # 允许的用户列表（仅 dispatcher 角色）
    # 只有在此列表中的用户才能发起任务
    # 获取方式: 在飞书管理后台查看用户 ID
    allowed_users:
      - "ou_xxxxxxxxxxxxxxxxx"
      - "ou_yyyyyyyyyyyyyyyyyy"
      - "ou_zzzzzzzzzzzzzzzzzzzz"
    # 群组到项目名的映射（可选）
    # 用于根据用户所在的群组自动补充项目关键词（土豆、迷雾等）
    # 例如：在"土豆开发群"中说"重启"，会自动补充为"土豆 重启"
    # 适用场景：群组按项目划分时，用户无需每次说项目名
    group_project_map:
      "oc_xxx_potato_dev": "土豆"    # 土豆开发群 → 土豆
      "oc_yyy_potato_test": "土豆"   # 土豆测试群 → 土豆
      "oc_zzz_mist_dev": "迷雾"      # 迷雾开发群 → 迷雾
      "oc_www_mist_test": "迷雾"     # 迷雾测试群 → 迷雾
    # 语义匹配配置（可选，用于新模式三层匹配）
    semantic_match:
      enabled: true                    # 是否启用语义匹配
      threshold: 0.7                  # 相似度阈值，0.0-1.0，低于此值不分发任务
      provider: "glm"                 # "glm" 或 "openai"
      model: "embedding-3"            # glm: embedding-3, openai: text-embedding-ada-002
      api_key: "${GLM_API_KEY}"       # 从环境变量读取 API Key

  # ====================
  # 执行机器人 1 - 开发服专员（新三层匹配配置）
  # ====================
  # 新配置格式示例：支持三层语义匹配
  # 用户输入 "土豆开发服重启" 会自动匹配到对应的任务和脚本
  - name: "dev-executor"
    app_id: "cli_yyyyyyyyyyyyyyyyyy"
    app_secret: "yyyyyyyyyyyyyyyyyy"
    role: "executor"
    description: "开发服执行机器人"
    # 允许的 dispatcher app_id 列表
    allowed_dispatchers:
      - "cli_xxxxxxxxxxxxxxxxx"  # task-dispatcher 的 app_id
    # 路由关键词（第一层粗匹配，用于快速定位 executor）
    routing_keywords:
      - "开发"
      - "dev"
      - "development"
    # 任务列表（新格式）
    tasks:
      # 任务 1: 迷雾服务器
      - keywords: ["迷雾", "mist"]  # 第二层精匹配：命中任何一个即确定任务
        names: ["重启", "重新启动", "restart", "reload"]  # 第三层：操作名候选（精确或语义匹配）
        script: "/opt/scripts/mist_dev_restart.sh"
      - keywords: ["迷雾", "mist"]
        names: ["更新", "升级", "update", "upgrade"]
        script: "/opt/scripts/mist_dev_update.sh"
      # 任务 2: 土豆服务器
      - keywords: ["土豆", "potato"]
        names: ["重启", "重新启动", "restart", "reload"]
        script: "/opt/scripts/potato_dev_restart.sh"
      - keywords: ["土豆", "potato"]
        names: ["更新", "升级", "update", "upgrade"]
        script: "/opt/scripts/potato_dev_update.sh"
    # 轮询间隔（可选，默认 "1s"）
    poll_interval: "1s"
    # 最大并发任务数（可选，默认 0 表示不限制）
    # 如果需要限制并发执行的任务数量，可设置为正整数，如 3 表示最多同时执行 3 个任务
    max_tasks: 0

  # ====================
  # 执行机器人 2 - 测试服专员（旧配置格式，向后兼容）
  # ====================
  # 旧配置格式示例：精确匹配任务名
  # 用户输入必须完全匹配 task_scripts 中的键名
  - name: "test-executor"
    app_id: "cli_zzzzzzzzzzzzzzzzzzzz"
    app_secret: "zzzzzzzzzzzzzzzzzzzz"
    role: "executor"
    allowed_dispatchers:
      - "cli_xxxxxxxxxxxxxxxxx"  # task-dispatcher 的 app_id
    # 旧格式：任务名 -> 脚本路径映射（精确匹配）
    task_scripts:
      run_test: "/opt/scripts/run_test.sh"
      e2e_test: "/opt/scripts/e2e_test.sh"
      deploy_staging: "/opt/scripts/deploy_staging.sh"
    # 轮询间隔（可选，默认 "1s"）
    poll_interval: "2s"

  # ====================
  # 执行机器人 3 - 混合模式（同时支持新旧配置）
  # ====================
  # 优先使用 tasks（新格式），如果为空则回退到 task_scripts（旧格式）
  - name: "prod-executor"
    app_id: "cli_wwwwwwwwwwwwwwwwwwww"
    app_secret: "wwwwwwwwwwwwwwwwwwww"
    role: "executor"
    description: "生产服执行机器人"
    allowed_dispatchers:
      - "cli_xxxxxxxxxxxxxxxxx"
    routing_keywords:
      - "生产"
      - "prod"
      - "production"
    # 新格式任务配置（优先使用）
    tasks:
      - keywords: ["生产服", "生产"]
        names: ["回滚", "rollback", "回退"]
        script: "/opt/scripts/prod_rollback.sh"
    # 旧格式（当 tasks 为空时使用）
    task_scripts:
      health_check: "/opt/scripts/prod_health_check.sh"
      backup_db: "/opt/scripts/prod_backup_db.sh"
    poll_interval: "5s"

# ====================
# 配置说明
# ====================
#
## 机器人角色说明
#
### Dispatcher (分发机器人)
# - 必须加入用户群，接收用户在群里 @ 机器人的消息
# - 验证用户是否在 allowed_users 白名单中
# - 支持两种匹配模式（自动检测）：
#   * 新模式：当任一 executor 配置了 tasks 时启用三层语义匹配
#   * 旧模式：所有 executor 都只配置了 task_scripts 时使用精确匹配
# - 在机器人群发送结构化消息（新）或纯文本任务名（旧）
# - 私聊时回复用户告知任务已转发
#
### Executor (执行机器人)
# - 只加入机器人群
# - 通过 sender app_id 校验是否来自允许的 dispatcher
# - 监听群消息，解析并执行任务
# - 执行脚本并汇报结果到机器人群
#
## 三层语义匹配流程（新模式）
#
# 用户输入: "土豆开发服重启一下"
#
# 第一层 - Executor 路由（粗匹配）:
#   在 routing_keywords 中模糊匹配 "开发" → 命中 dev-executor
#   剩余文本: "土豆重启一下"
#
# 第二层 - Task 关键词过滤（精匹配）:
#   在所有 tasks 的 keywords 中精确匹配 "土豆" → 命中土豆服务器任务
#   剩余文本: "重启一下"
#
# 第三层 - 操作名匹配（精确 + 语义兜底）:
#   在 names 中先精确匹配 "重启" → 命中！
#   如果精确失败，则语义匹配 "重启一下" 最接近 "重启"
#
# 最终结果: 执行 potato_dev_restart.sh
#
## 安全配置建议
#
# 1. 用户白名单: 严格限制可以发起任务的用户
# 2. Executor 安全校验:
#    - allowed_dispatchers: 只接受特定 dispatcher 的命令（按 app_id）
#    - tasks/task_scripts: 只允许执行白名单中的脚本
# 3. 脚本权限: 确保脚本文件权限正确（如 750）
# 4. 网络隔离: 机器人之间在专门的机器人群通信
#
## 获取飞书应用信息
#
# 1. app_id 和 app_secret:
#    - 访问 https://open.feishu.cn/app
#    - 创建应用或选择已有应用
#    - 在应用凭证页面查看 App ID 和 App Secret
#
# 2. robot_group_id:
#    - 在飞书中创建机器人专用群
#    - 在群设置中查看群 ID
#
# 3. allowed_users 中的用户 ID:
#    - 在飞书管理后台查看用户信息
#    - 或通过 API 获取用户 ID
#
# 4. Executor 权限:
#    - 在飞书开放平台为 executor 应用申请 im:message.group_msg 权限
#    - 这是免审权限，可直接获取
#
## 使用示例
#
### 新模式（三层语义匹配）
# 用户输入: "土豆 dev 重启"
#   → Dispatcher 三层匹配
#   → 发送: "cmd:重启_dev-executor|script:/opt/scripts/potato_dev_restart.sh"
#   → dev-executor 执行脚本
#   → 返回结果
#
### 旧模式（精确匹配）
# 用户输入: "@task-dispatcher run_test"
#   → Dispatcher 精确匹配 "run_test"
#   → 发送: "run_test"
#   → test-executor 执行 /opt/scripts/run_test.sh
#   → 返回结果
#
## 边界情况处理
#
# 1. 否定意图: "土豆开发服不要重启"
#    → 检测到 "不要" → 拒绝执行，提示用户
#
# 2. 多意图: "把土豆和迷雾的开发服都重启一下"
#    → 检测到多个匹配 → 拒绝执行，提示一次只说一个
#
# 3. 未匹配: "那个服务器搞一下"
#    → 无匹配 → 提示用户明确服务器名和操作
